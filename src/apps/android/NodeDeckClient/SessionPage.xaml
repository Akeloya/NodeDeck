<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NodeDeckClient.SessionPage" Title="Подключение">
    <Grid Padding="20">
        <VerticalStackLayout x:Name="ConnectionPanel" Spacing="14" VerticalOptions="Center">
            <Label x:Name="ConnectionTitle" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="ConnectionStatus" />
            <ActivityIndicator x:Name="Connecting" />
            <Button x:Name="RetryButton" Text="Повторить" Clicked="OnRetryClicked" />
            <Button Text="Другие подключения" Clicked="OnChooseClicked" />
        </VerticalStackLayout>
        <ScrollView x:Name="CommandsPanel" IsVisible="False">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="GatewayName" FontSize="22" FontAttributes="Bold" />
                <Entry x:Name="MessageEntry" Text="Hello from phone" Placeholder="Сообщение для команды" />
                <VerticalStackLayout x:Name="CommandButtons" Spacing="10" />
                <Label x:Name="ResultLabel" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
