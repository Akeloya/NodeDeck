<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NodeDeckClient.MainPage"
             Title="NodeDeck">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="NodeDeck demo" Style="{StaticResource Headline}" />
            <Picker x:Name="TransportPicker" Title="Transport" SelectedIndex="0" SelectedIndexChanged="OnTransportChanged">
                <Picker.Items>
                    <x:String>TCP</x:String>
                    <x:String>Bluetooth LE</x:String>
                </Picker.Items>
            </Picker>
            <Label x:Name="TcpHelpLabel" Text="Enter the computer's LAN IP. For an Android emulator use 10.0.2.2 when the gateway runs on the host." />
            <Entry x:Name="HostEntry" Text="10.0.2.2" Placeholder="Gateway IP address" Keyboard="Url" />
            <Entry x:Name="PortEntry" Text="5050" Placeholder="Port" Keyboard="Numeric" />
            <Entry x:Name="SecretEntry" Text="nodedeck-dev" Placeholder="Shared secret" IsPassword="True" />
            <Button x:Name="ConnectButton" Text="Connect" Clicked="OnConnectClicked" />
            <Entry x:Name="MessageEntry" Text="Hello from phone" Placeholder="Command message" />
            <Button Text="Say hello" Clicked="OnCommandClicked" CommandParameter="phone.hello" />
            <Button Text="Get status" Clicked="OnCommandClicked" CommandParameter="phone.status" />
            <Button Text="Run action" Clicked="OnCommandClicked" CommandParameter="phone.action" />
            <Label x:Name="StatusLabel" Text="Disconnected" />
            <Label x:Name="ResultLabel" Text="" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
