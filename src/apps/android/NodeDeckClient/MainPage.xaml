<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:strings="clr-namespace:NodeDeckClient.Resources.Strings"
             xmlns:local="clr-namespace:NodeDeckClient"
             x:Class="NodeDeckClient.MainPage" Title="{x:Static strings:AppResources.Connections}">
    <Grid Padding="20" RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="12">
        <Button Text="{x:Static strings:AppResources.ScanQrCode}" IsEnabled="False" />
        <Label Grid.Row="1" Text="{x:Static strings:AppResources.SavedConnections}" FontSize="22" FontAttributes="Bold" />
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4">
            <Grid.Resources>
                <Style TargetType="ImageButton">
                    <Setter Property="WidthRequest" Value="48" />
                    <Setter Property="HeightRequest" Value="48" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="VerticalOptions" Value="Center" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light=#6550A3, Dark=#BBA9F8}" />
                    <Setter Property="BorderWidth" Value="0" />
                </Style>
            </Grid.Resources>
            <ImageButton x:Name="WifiFilter" Source="wifi.png" SemanticProperties.Description="{x:Static strings:AppResources.WifiFilter}"
                         Clicked="OnTransportFilterClicked" />
            <ImageButton x:Name="BluetoothFilter" Grid.Column="1" Source="bluetooth.png"
                         SemanticProperties.Description="{x:Static strings:AppResources.BluetoothFilter}" Clicked="OnTransportFilterClicked" />
            <SearchBar Grid.Column="2" Placeholder="{x:Static strings:AppResources.FindConnection}" TextChanged="OnSearchChanged" />
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Button x:Name="ConnectButton" Text="{x:Static strings:AppResources.Connect}" Clicked="OnConnectClicked" />
            <Button x:Name="EditButton" Grid.Column="1" Text="{x:Static strings:AppResources.Configure}" Clicked="OnEditClicked" />
        </Grid>
        <CollectionView x:Name="Connections" Grid.Row="4" SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged" EmptyView="{x:Static strings:AppResources.NoConnectionsFound}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ConnectionProfile">
                    <Grid Padding="12" ColumnDefinitions="32,*" ColumnSpacing="14">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAE4FF, Dark=#3E3257}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Image Source="{Binding Icon}" WidthRequest="28" HeightRequest="28" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" />
                            <Label Text="{Binding Detail}" FontSize="13" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
