<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="NodeDeckClient.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NodeDeckClient"
    xmlns:strings="clr-namespace:NodeDeckClient.Resources.Strings"
    Title="{x:Static strings:AppResources.Connections}">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        RowSpacing="12">
        <Button IsEnabled="False" Text="{x:Static strings:AppResources.ScanQrCode}" />
        <Label
            Grid.Row="1"
            FontAttributes="Bold"
            FontSize="22"
            Text="{x:Static strings:AppResources.SavedConnections}" />
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,Auto,*"
            ColumnSpacing="4">
            <Grid.Resources>
                <Style TargetType="ImageButton">
                    <Setter Property="WidthRequest" Value="48" />
                    <Setter Property="HeightRequest" Value="48" />
                    <Setter Property="Padding" Value="10" />
                    <Setter Property="VerticalOptions" Value="Center" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light=#6550A3, Dark=#BBA9F8}" />
                    <Setter Property="BorderWidth" Value="0" />
                </Style>
            </Grid.Resources>
            <ImageButton
                x:Name="WifiFilter"
                Clicked="OnTransportFilterClicked"
                SemanticProperties.Description="{x:Static strings:AppResources.WifiFilter}"
                Source="wifi.png" />
            <ImageButton
                x:Name="BluetoothFilter"
                Grid.Column="1"
                Clicked="OnTransportFilterClicked"
                SemanticProperties.Description="{x:Static strings:AppResources.BluetoothFilter}"
                Source="bluetooth.png" />
            <SearchBar
                Grid.Column="2"
                Placeholder="{x:Static strings:AppResources.FindConnection}"
                TextChanged="OnSearchChanged" />
        </Grid>
        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
            <Button
                x:Name="ConnectButton"
                Clicked="OnConnectClicked"
                Text="{x:Static strings:AppResources.Connect}" />
            <Button
                x:Name="EditButton"
                Grid.Column="1"
                Clicked="OnEditClicked"
                Text="{x:Static strings:AppResources.Configure}" />
        </Grid>
        <CollectionView
            x:Name="Connections"
            Grid.Row="4"
            EmptyView="{x:Static strings:AppResources.NoConnectionsFound}"
            SelectionChanged="OnSelectionChanged"
            SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:ConnectionProfile">
                    <Grid
                        Padding="12"
                        ColumnDefinitions="32,*"
                        ColumnSpacing="14">
                        <Image
                            HeightRequest="28"
                            Source="{Binding Icon}"
                            WidthRequest="28" />
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label FontAttributes="Bold" Text="{Binding DisplayName}" />
                            <Label FontSize="13" Text="{Binding Detail}" />
                        </VerticalStackLayout>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal" />
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EAE4FF, Dark=#3E3257}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout
            Grid.Row="5"
            HorizontalOptions="Center"
            Spacing="4">
            <Label
                x:Name="AppVersionLabel"
                FontSize="12"
                HorizontalTextAlignment="Center" />
            <Button
                Padding="12,4"
                BackgroundColor="Transparent"
                Clicked="OnPoweredByClicked"
                Text="Powered by Akeloya"
                TextColor="{AppThemeBinding Light=#6550A3,
                                            Dark=#BBA9F8}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
